rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {
      // Il sito può creare ordini e prenotazioni
      allow create: if true;

      // Il cliente vede i propri ordini/prenotazioni.
      // I partecipanti selezionati vedono la stessa prenotazione di gruppo.
      // L'amministratore vede tutto.
      allow read:
        if request.auth != null
        && (
          request.auth.uid == "vaQyMYFpkrNU0rsc6aGSnNTHmt43"
          || resource.data.customerUid == request.auth.uid
          || (
            resource.data.groupMemberUids is list
            && request.auth.uid in resource.data.groupMemberUids
          )
        );

      // Solo l'amministratore modifica o elimina
      allow update, delete:
        if request.auth != null
        && request.auth.uid == "vaQyMYFpkrNU0rsc6aGSnNTHmt43";
    }

    match /counters/{day} {
      allow read, create, update: if true;
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "vaQyMYFpkrNU0rsc6aGSnNTHmt43";
    }

    // ALBERTO FIDELITY
    match /fidelityUsers/{uid} {
      allow create, read, update:
        if request.auth != null
        && request.auth.uid == uid;
    }

    match /fidelityCustomers/{code} {
      allow create:
        if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.points == 0;

      allow read:
        if request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || request.auth.uid == "vaQyMYFpkrNU0rsc6aGSnNTHmt43"
        );

      allow update:
        if request.auth != null
        && (
          (
            resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.points == resource.data.points
          )
          || request.auth.uid == "vaQyMYFpkrNU0rsc6aGSnNTHmt43"
        );
    }

    match /fidelityTransactions/{transactionId} {
      allow read, create:
        if request.auth != null
        && request.auth.uid == "vaQyMYFpkrNU0rsc6aGSnNTHmt43";

      allow update, delete: if false;
    }

    match /referrals/{id} {
      allow create:
        if request.auth != null
        && request.resource.data.invitedCustomer == id;
    }

    // GRUPPI UFFICIO
    match /officeGroups/{groupCode} {

      allow create:
        if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      allow read:
        if request.auth != null
        && exists(
          /databases/$(database)/documents/officeGroups/$(groupCode)/members/$(request.auth.uid)
        );

      allow update, delete:
        if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {

        allow create:
          if request.auth != null
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && exists(
            /databases/$(database)/documents/officeGroups/$(groupCode)
          );

        allow read:
          if request.auth != null
          && exists(
            /databases/$(database)/documents/officeGroups/$(groupCode)/members/$(request.auth.uid)
          );

        allow update:
          if request.auth != null
          && uid == request.auth.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;

        allow delete:
          if request.auth != null
          && (
            uid == request.auth.uid
            || get(
              /databases/$(database)/documents/officeGroups/$(groupCode)
            ).data.ownerUid == request.auth.uid
          );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
