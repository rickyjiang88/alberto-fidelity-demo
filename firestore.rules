rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{orderId} {
      // Creazione pubblica consentita solo per richieste nel formato previsto.
      // Se il cliente è autenticato, l'ordine deve appartenere al suo UID.
      allow create:
        if (
          (
            request.resource.data.type == "PREORDER"
            && request.resource.data.status == "NUOVO"
            && request.resource.data.items is list
            && request.resource.data.items.size() > 0
            && request.resource.data.items.size() <= 100
            && request.resource.data.total >= 0
            && request.resource.data.total <= 10000
          )
          ||
          (
            request.resource.data.type == "TABLE_BOOKING"
            && request.resource.data.status == "IN ATTESA"
            && request.resource.data.bookingStatus == "IN ATTESA"
            && request.resource.data.covers >= 1
            && request.resource.data.covers <= 200
            && request.resource.data.date is string
            && request.resource.data.time is string
          )
        )
        && (
          (request.auth == null && request.resource.data.customerUid == null)
          || (request.auth != null && request.resource.data.customerUid == request.auth.uid)
        );

      // Il cliente vede i propri ordini/prenotazioni.
      // I membri dello stesso gruppo vedono la prenotazione condivisa.
      // L'amministratore vede tutto.
      allow read:
        if request.auth != null
        && (
          request.auth.uid == "vaQyMYFpkrNU0rsc6aGSnNTHmt43"
          || resource.data.customerUid == request.auth.uid
          || (
            resource.data.groupMemberUids is list
            && request.auth.uid in resource.data.groupMemberUids
          )
          || (
            resource.data.groupCode is string
            && exists(
              /databases/$(database)/documents/officeGroups/$(resource.data.groupCode)/members/$(request.auth.uid)
            )
          )
        );

      // Solo l'amministratore modifica o elimina.
      allow update, delete:
        if request.auth != null
        && request.auth.uid == "vaQyMYFpkrNU0rsc6aGSnNTHmt43";
    }

    match /counters/{day} {
      // Il contatore resta leggibile per consentire il numero progressivo,
      // ma non può più essere riscritto con valori arbitrari.
      allow read: if true;

      allow create:
        if request.resource.data.last == 1
        && request.resource.data.day == day;

      allow update:
        if request.resource.data.last == resource.data.last + 1
        && request.resource.data.day == resource.data.day
        && request.resource.data.day == day;

      allow delete: if false;
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "vaQyMYFpkrNU0rsc6aGSnNTHmt43";
    }

    // ALBERTO FIDELITY
    match /fidelityUsers/{uid} {
      allow create, read, update:
        if request.auth != null
        && request.auth.uid == uid;
    }

    match /fidelityCustomers/{code} {
      allow create:
        if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get("points", 0) == 0
        && request.resource.data.get("walletBalance", 0) == 0;

      allow read:
        if request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || request.auth.uid == "vaQyMYFpkrNU0rsc6aGSnNTHmt43"
        );

      // Il cliente può cambiare solo i dati del proprio profilo e le preferenze.
      // Punti, saldo portafoglio, premi e bonus referral possono essere modificati
      // soltanto dal pannello amministratore.
      allow update:
        if request.auth != null
        && (
          (
            resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.get("points", 0) == resource.data.get("points", 0)
            && request.resource.data.get("walletBalance", 0) == resource.data.get("walletBalance", 0)
            && request.resource.data.get("referralRewarded", false) == resource.data.get("referralRewarded", false)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "name",
              "surname",
              "phone",
              "birthDate",
              "walletActive",
              "officeGroupName",
              "officeGroupCode",
              "groupCode",
              "officeGroupCodes",
              "officeGroupOwnerCode",
              "officeGroupOwnerName",
              "groupName",
              "groupOwnerName",
              "referredBy",
              "referralStatus",
              "updatedAt"
            ])
          )
          || request.auth.uid == "vaQyMYFpkrNU0rsc6aGSnNTHmt43"
        );
    }

    match /fidelityTransactions/{transactionId} {
      allow read, create:
        if request.auth != null
        && request.auth.uid == "vaQyMYFpkrNU0rsc6aGSnNTHmt43";

      allow update, delete: if false;
    }

    match /referrals/{id} {
      allow create:
        if request.auth != null
        && request.resource.data.invitedCustomer == id;
    }

    // GRUPPI UFFICIO
    match /officeGroups/{groupCode} {

      allow create:
        if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      allow read:
        if request.auth != null
        && exists(
          /databases/$(database)/documents/officeGroups/$(groupCode)/members/$(request.auth.uid)
        );

      allow update, delete:
        if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {

        allow create:
          if request.auth != null
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && exists(
            /databases/$(database)/documents/officeGroups/$(groupCode)
          );

        allow read:
          if request.auth != null
          && exists(
            /databases/$(database)/documents/officeGroups/$(groupCode)/members/$(request.auth.uid)
          );

        allow update:
          if request.auth != null
          && uid == request.auth.uid
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;

        allow delete:
          if request.auth != null
          && (
            uid == request.auth.uid
            || get(
              /databases/$(database)/documents/officeGroups/$(groupCode)
            ).data.ownerUid == request.auth.uid
          );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
